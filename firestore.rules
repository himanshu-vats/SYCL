rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leagues/{slug} {
      allow read: if true;
      allow write: if false;
      match /{subcollection=**} {
        allow read: if true;
        allow write: if false;
      }
    }
    match /meta/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /aiFeedback/{document=**} {
      allow read: if false;
      allow write: if true;
    }
    match /chatLogs/{document=**} {
      allow read: if false;
      allow write: if true;
    }
    match /chatUsage/{document=**} {
      allow read: if false;
      allow write: if true;
    }
    match /feedback/{document=**} {
      allow read: if false;
      allow write: if true;
    }
  }
}
